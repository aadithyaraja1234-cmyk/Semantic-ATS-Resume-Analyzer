# Copy this file to .env and fill in your values.

# Which LLM to use via LiteLLM, as "provider/model".
# Default: groq/llama-3.1-8b-instant
MODEL_NAME=groq/llama-3.1-8b-instant

# API key for whichever provider MODEL_NAME points at.
# For the default (groq/*), get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# If you switch MODEL_NAME to a different provider, set that provider's key
# instead, e.g.:
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
